body {
    font-family: Times New Roman;
    background-color: lightblue;
    padding: 35px;
}

.container {
    width: 350px;
    margin: auto;
    background-color: white;
    padding: 25px;
    border-radius: 10px;
    
}

h2 {
    text-align: center;
    color: maroon;
}

input {
    width: 100%;
    padding: 10px;
    margin: 8px 0;
    box-sizing: border-box;
}

button {
    width: 100%;
    padding: 10px;
    background-color: lightgreen;
    color: black;
    border: none;
    border-radius: 8px;
}

#hasil {
    margin-top: 20px;
    padding: 15px;
    background-color: grey;
}
.lulus {
    color: darkgreen;
    font-weight: bold;
}

.tidak-lulus {
    color: maroon;
    font-weight: bold;
}
